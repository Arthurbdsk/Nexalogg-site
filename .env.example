# Domínio público do site (usado em canonical, Open Graph, sitemap e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.nexallog.com.br

# Google Analytics 4 / Google Tag Manager (deixe vazio para desativar o carregamento)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=

# Envio do formulário por e-mail (server-side, nunca exposto ao browser)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=NEXALLOG Site <site@nexallog.com>
CONTACT_INBOX=alexandre.felix@nexallog.com

# Destino alternativo do formulário
CONTACT_WEBHOOK_URL=

# Verificação do Google Search Console (opcional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
